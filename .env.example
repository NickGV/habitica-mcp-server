# Habitica MCP Server configuration
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env

# --- Required ---
# Habitica User ID (Settings -> API tab -> User ID)
HABITICA_USER_ID=your-user-id

# Habitica API Token (Settings -> API tab -> API Token)
HABITICA_API_TOKEN=your-api-token

# --- Optional ---
# Language for server messages: 'en' (default) or 'zh-CN'
# MCP_LANG=en
